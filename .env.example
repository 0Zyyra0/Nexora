# Copy the values below into cPanel → Setup Python App → your app →
# "Environment variables" section (do NOT upload this file with real
# secrets in it to a public repo).

# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-this-with-a-real-random-secret-key

# Must be False on the live site.
DJANGO_DEBUG=False

# Your domain(s), comma-separated, no scheme, no spaces.
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Same domains but WITH the https:// scheme — required for the
# contact form (POST) to work over HTTPS.
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
